{
  "name": "lifeos",
  "version": "0.1.0",
  "description": "LifeOS · 个人智能操作系统 - 本地后端",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "runtime-check": "node tools/runtime-check.cjs",
    "runtime-check:electron": "electron tools/runtime-check.cjs",
    "test:storage": "node --test tests/storage.test.cjs",
    "test:security": "node --test tests/security.test.cjs",
    "test:content": "node --test tests/content.test.cjs",
    "test:vault": "node --test tests/vault.test.cjs",
    "test:contracts": "node --test tests/contracts.test.cjs",
    "test:core": "node --test tests/domain.test.cjs tests/core.test.cjs",
    "test:desktop": "node --test tests/desktop.test.cjs",
    "test": "node --test \"tests/*.test.cjs\"",
    "start": "node server/server.js",
    "dev": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "js-yaml": "^5.4.2",
    "zod": "^4.6.5"
  }
}
